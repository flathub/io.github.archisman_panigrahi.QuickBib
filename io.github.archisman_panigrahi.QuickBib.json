{
  "app-id": "io.github.archisman_panigrahi.QuickBib",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "base": "com.riverbankcomputing.PyQt.BaseApp",
  "base-version": "6.11",
  "finish-args": [
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri"
  ],
  "cleanup": [
    "/share/doc"
  ],
  "cleanup-commands": [
    "/app/cleanup-BaseApp.sh",
    "python3 -m compileall --invalidation-mode=unchecked-hash /app"
  ],
  "command": "quickbib",
